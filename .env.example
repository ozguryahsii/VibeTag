# PostgreSQL, in development as well as production — see docker-compose.yml.
#   docker compose up -d db
#
# Port 5433, not 5432: a Mac with Postgres.app or Homebrew's postgresql
# already owns the default one. Change DB_PORT and this URL together if 5433
# is taken too.
DATABASE_URL="postgresql://vibetag:vibetag@localhost:5433/vibetag"
DB_PORT="5433"

# Already running your own PostgreSQL? Skip Docker entirely and point at it:
#   createdb vibetag
#   DATABASE_URL="postgresql://<your-user>@localhost:5432/vibetag"
#
# In production DATABASE_URL is ignored: docker-compose.prod.yml overrides it
# with the address of the database on its own private network.

# --- production only (docker-compose.prod.yml) ---------------------------
# Database password. No default — the stack refuses to start without one
# rather than quietly coming up open.
POSTGRES_PASSWORD=""

# Host port the app listens on, bound to 127.0.0.1. Your reverse proxy is what
# faces the internet. Change it if 3100 is taken on the box.
APP_PORT="3100"

# Only when your reverse proxy is itself a container — see
# docker-compose.proxy.yml. The existing Docker network the proxy sits on; the
# app joins it and is reached by container name instead of a host port.
PROXY_NETWORK=""

# Absolute origin for links that leave the app: invite URLs, QR codes, share
# sheets. Guessed from the request host when unset, which is right locally and
# wrong the moment a proxy or a custom domain is involved — set it in prod.
NEXT_PUBLIC_APP_URL=""

# Where a suspended person appeals, and where the legal texts point.
# Shown to users, so it has to be an address someone actually reads.
SUPPORT_EMAIL="destek@vibetag.app"

# Shared secret for POST /api/cron/fraud-sweep. Leave unset and the route
# refuses outright — an open endpoint that rewrites every score is worse
# than no cron at all.
CRON_SECRET=""

# Web Push (VAPID). Generate with:  npx web-push generate-vapid-keys
# Leave unset and push is simply off; the settings toggle does not render.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:destek@vibetag.app"

# --------------------------------------------------------------------- email
# Transactional mail, through Resend (resend.com). Used for the sign-up code
# and for password resets — without it, neither can be delivered and new
# accounts cannot get past the verification screen.
#
# Two steps, in this order:
#   1. Add the domain at Resend → Domains and put the DKIM/SPF records it
#      shows you into Cloudflare DNS. Unverified domains get rejected or
#      filed as spam, which for a sign-up code is the same as not sending.
#   2. Create an API key at Resend → API Keys.
#
# In development you can leave both empty: the code is printed to the server
# log instead. That fallback is off in production on purpose.
RESEND_API_KEY=""
EMAIL_FROM="Vibe Tag <noreply@vibetag.net>"
