# SQLite for local dev. For production, switch the datasource provider in
# prisma/schema.prisma to "postgresql" and point this at your database:
# DATABASE_URL="postgresql://user:pass@localhost:5432/vibetag"
DATABASE_URL="file:./dev.db"

# Session cookie signing secret
AUTH_SECRET="change-me-in-production"

# Where a suspended person can appeal, and where legal notices point.
# Shown to users, so it has to be an address someone actually reads.
SUPPORT_EMAIL="destek@vibetag.app"

# Shared secret for POST /api/cron/fraud-sweep. Leave unset and the route
# refuses outright — an open endpoint that rewrites every score is worse
# than no cron at all.
CRON_SECRET=""

# Web Push (VAPID). Generate with:  npx web-push generate-vapid-keys
# Leave unset and push is simply off; nothing else changes.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:destek@vibetag.app"
