# PostgreSQL, in development as well as production — see docker-compose.yml.
#   docker compose up -d db
#
# Port 5433, not 5432: a Mac with Postgres.app or Homebrew's postgresql
# already owns the default one. Change DB_PORT and this URL together if 5433
# is taken too.
DATABASE_URL="postgresql://vibetag:vibetag@localhost:5433/vibetag"
DB_PORT="5433"

# Already running your own PostgreSQL? Skip Docker entirely and point at it:
#   createdb vibetag
#   DATABASE_URL="postgresql://<your-user>@localhost:5432/vibetag"

# Absolute origin for links that leave the app: invite URLs, QR codes, share
# sheets. Guessed from the request host when unset, which is right locally and
# wrong the moment a proxy or a custom domain is involved — set it in prod.
NEXT_PUBLIC_APP_URL=""

# Where a suspended person appeals, and where the legal texts point.
# Shown to users, so it has to be an address someone actually reads.
SUPPORT_EMAIL="destek@vibetag.app"

# Shared secret for POST /api/cron/fraud-sweep. Leave unset and the route
# refuses outright — an open endpoint that rewrites every score is worse
# than no cron at all.
CRON_SECRET=""

# Web Push (VAPID). Generate with:  npx web-push generate-vapid-keys
# Leave unset and push is simply off; the settings toggle does not render.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:destek@vibetag.app"
