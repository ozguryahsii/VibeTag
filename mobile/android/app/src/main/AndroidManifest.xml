<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Nearby. The page asks through the browser Geolocation API, and
      Capacitor's WebChromeClient answers by requesting both of these at
      runtime; undeclared, Android refuses without asking and the app's
      permission screen shows no Location row at all, so nobody can grant
      what the app is asking for.

      Coarse is what the feature actually needs — the fix asks with
      enableHighAccuracy false, and the server rounds what it stores — but
      the bridge requests the pair, so the pair is declared. On Android 12+
      this also lets someone hand over an approximate location instead of a
      precise one, which is the right default for a list sorted by distance
      bands.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      Declaring the permissions above makes Play treat location hardware as
      required, and a device without a GPS chip then cannot see the app at
      all. Nearby is one optional screen in a social app, not the reason it
      exists — so the feature is declared optional and the rest of the app
      stays installable on anything.
    -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.network"
        android:required="false" />
</manifest>
