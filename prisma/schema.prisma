// Vibe Tag — Social Reputation & Human Identity Platform
//
// PostgreSQL, in development as well as production. Running the two on
// different engines is how you ship a bug like case-sensitive search: SQLite's
// LIKE ignores case, Postgres's does not, and the dev database cheerfully
// says everything works.
//
// `docker compose up -d db` gives you one locally; see README.
//
// JSON-shaped columns (fraudFlags, snapshot, notification vars) are stored as
// text rather than `Json`. They are written and read by our own code as whole
// values — never queried into — so a native JSON column would buy nothing and
// cost a migration the day we want to move.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- users

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  username     String  @unique
  name         String
  passwordHash String
  bio          String?
  /// Uploaded profile photo (data URL in dev; object-storage URL in prod).
  avatarUrl    String?
  avatarColor  String  @default("#FF8A3D")

  // FREE | SILVER (Vibe Insights) | GOLD (Vibe Identity)
  plan String @default("FREE")

  /// When a granted plan runs out. Null means it does not — either the person
  /// is on FREE, or an admin gave them something permanent. The nightly sweep
  /// is what actually drops them back; a plan that expires only when somebody
  /// happens to look at it is not an expiry.
  planUntil DateTime?

  /// Trust signal used by fake-rating detection and shown as ✅ on profiles.
  /// True once any verification has been passed — today that means email.
  isVerified Boolean @default(false)

  /// One timestamp per verification method, so a profile can say *how* it was
  /// verified rather than just that it was. Phone and identity are not offered
  /// yet; the columns exist so the badge shelf and the schema agree from the
  /// start instead of being retrofitted around a live table.
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  idVerifiedAt    DateTime?

  /// When they ticked "I read and accept" at registration — the privacy
  /// policy, KVKK notice and terms, as one consent. Null on accounts that
  /// predate the checkbox.
  termsAcceptedAt DateTime?

  /// New accounts must confirm their email before the app opens. Accounts that
  /// existed before verification was introduced are grandfathered — being
  /// locked out of an account you already had is not a security improvement.
  mustVerifyEmail Boolean @default(true)

  /// Can open the moderation queue. Not a role system — one boolean is
  /// honest about what this actually is until there is a second kind of staff.
  isAdmin Boolean @default(false)

  /// Set when moderation actions an account report. A suspended account
  /// cannot sign in or rate; the row and its history stay intact.
  suspendedAt DateTime?

  /// Who may write a note when rating this person: EVERYONE | CIRCLE (the
  /// people they invited and their friends, as one group). Ratings
  /// themselves are open to everyone — this gates only the free-text note,
  /// which is where harassment actually happens.
  commentPolicy String @default("EVERYONE")

  /// Last language this person chose. The UI reads a cookie; a push
  /// notification has no request to read one from, so the choice is mirrored
  /// here the moment they make it.
  locale String @default("en")

  /// Opt-in, coarse location for the "people near me" list.
  ///
  /// Rounded to ~100 m before it is stored: enough to sort a list by
  /// distance, not enough to find someone's front door. Off by default.
  shareLocation Boolean   @default(false)
  lat           Float?
  lng           Float?
  locationAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions        Session[]
  otpCodes        OtpCode[]
  photos          ProfilePhoto[]
  redemptions     DiscountRedemption[]
  storePurchases  StorePurchase[]
  ratingsReceived Rating[]             @relation("RatingsReceived")
  ratingsGiven    Rating[]             @relation("RatingsGiven")

  invites         Invite[]
  inviteClaim     InviteClaim?
  badges          EarnedBadge[]
  friendsSent     Friendship[]       @relation("FriendRequester")
  friendsReceived Friendship[]       @relation("FriendAddressee")
  conversationsA  Conversation[]     @relation("ConvA")
  conversationsB  Conversation[]     @relation("ConvB")
  messagesSent    Message[]
  grantsGiven     InviteGrant[]      @relation("GrantsGiven")
  grantsHeld      InviteGrant[]      @relation("GrantsHeld")
  notifications   Notification[]
  pushSubs        PushSubscription[]
  blocksMade      Block[]            @relation("BlocksMade")
  blocksAgainst   Block[]            @relation("BlocksAgainst")
  reportsFiled    Report[]           @relation("ReportsFiled")
  reportsAbout    Report[]           @relation("ReportsAbout")
  reportsJudged   Report[]           @relation("ReportsReviewed")

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// -------------------------------------------------------------- ratings

/// One rater may hold exactly one rating per rated user (see @@unique).
/// Updates are allowed but throttled to one per 30 days and every version
/// is archived in RatingRevision.
model Rating {
  id String @id @default(cuid())

  ratedUserId String
  ratedUser   User   @relation("RatingsReceived", fields: [ratedUserId], references: [id], onDelete: Cascade)

  raterUserId String
  raterUser   User   @relation("RatingsGiven", fields: [raterUserId], references: [id], onDelete: Cascade)

  /// Relationship key from lib/taxonomy.ts — mandatory, drives which
  /// traits and vibe tags the rater is allowed to submit.
  relationship String

  comment String?

  /// The rater may hide their identity even from Gold members (§15).
  hideIdentity Boolean @default(false)

  /// Set by the fake-rating detector; protected ratings are never
  /// attributed to a person in the UI, on any plan.
  isProtected Boolean @default(false)
  fraudFlags  String  @default("[]") // JSON array of flag keys
  weight      Float   @default(1.0) // 0..1, dampens suspicious ratings

  /// Set when moderation upholds a report about this rating. Hidden ratings
  /// stop counting and their note disappears, but the row survives — the
  /// audit trail is the point, and a deleted row cannot be appealed.
  hiddenAt DateTime?

  updateCount   Int       @default(0)
  lastUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  traits    RatingTrait[]
  vibeTags  RatingVibeTag[]
  revisions RatingRevision[]

  @@unique([ratedUserId, raterUserId])
  @@index([ratedUserId])
  @@index([raterUserId])
  @@index([createdAt])
}

model RatingTrait {
  id       String @id @default(cuid())
  ratingId String
  rating   Rating @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  traitKey String
  score    Int // 1..5

  @@unique([ratingId, traitKey])
  @@index([traitKey])
}

model RatingVibeTag {
  id       String @id @default(cuid())
  ratingId String
  rating   Rating @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  tagKey   String

  @@unique([ratingId, tagKey])
  @@index([tagKey])
}

/// Immutable audit trail: a full snapshot of the rating as it was
/// *before* each update.
model RatingRevision {
  id       String @id @default(cuid())
  ratingId String
  rating   Rating @relation(fields: [ratingId], references: [id], onDelete: Cascade)

  version   Int
  snapshot  String // JSON: { relationship, comment, traits, vibeTags }
  createdAt DateTime @default(now())

  @@index([ratingId])
}

// --------------------------------------------------------------- growth

/// An invite link.
///
/// Every link is minted fresh and carries its own limits, because a single
/// permanent code defeats the "only people I invited may rate me" setting the
/// moment someone forwards it. A link is spent when enough distinct people
/// have used it, or when it expires, or when its owner revokes it.
model Invite {
  id        String  @id @default(cuid())
  code      String  @unique
  label     String?
  inviterId String
  inviter   User    @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  /// How many distinct people may use it. null = unlimited (an open link).
  maxUses   Int?
  expiresAt DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())

  claims InviteClaim[]
  grants InviteGrant[]

  @@index([inviterId])
}

/// "This person came in through one of my links, so they may rate me."
///
/// Separate from InviteClaim on purpose: a claim records where an *account*
/// came from and can only ever happen once, while a grant is permission
/// between two people and must also work for someone who already had an
/// account before you sent them a link.
model InviteGrant {
  id       String @id @default(cuid())
  inviteId String
  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  /// Denormalised from invite.inviterId so the rating check is a single read.
  ownerId String
  owner   User   @relation("GrantsGiven", fields: [ownerId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("GrantsHeld", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([ownerId, userId])
  @@index([inviteId])
  @@index([userId])
}

/// Who came in through which link. One claim per user — an account has
/// exactly one origin, which also gives the fraud detector a signal.
model InviteClaim {
  id        String   @id @default(cuid())
  inviteId  String
  invite    Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([inviteId])
}

/// A badge the user has actually been awarded.
///
/// Badges are computed from the profile on every render, but "earned" is an
/// event, not a calculation: without a row saying when it first happened,
/// there is nothing to congratulate someone for, and a score that dips would
/// silently take the badge back.
model EarnedBadge {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Family key from lib/badges.ts.
  key      String
  /// BRONZE | SILVER | GOLD. Each tier is earned and kept on its own, so
  /// reaching gold leaves three rows and the shelf can show the climb.
  tier     String   @default("BRONZE")
  earnedAt DateTime @default(now())

  @@unique([userId, key, tier])
  @@index([userId])
}

/// A browser push endpoint.
///
/// One row per device, not per user: the same person signs in on a phone and a
/// laptop and expects both to buzz. A dead endpoint is deleted the first time
/// the push service rejects it — keeping it would mean retrying forever.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// NEW_RATING | RATING_UPDATED | INVITE_JOINED | BADGE_EARNED |
  /// FRIEND_REQUEST | FRIEND_ACCEPTED | NEW_MESSAGE
  ///
  /// The copy is *not* stored. Writing a rendered sentence would freeze the
  /// notification in whatever language the person who triggered it happened
  /// to be reading — so only the type and its variables are kept, and the
  /// text is built in the reader's language when the list is drawn.
  type String
  /// JSON object of substitutions, e.g. {"name":"Deniz"}.
  vars String  @default("{}")
  href String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// --------------------------------------------------------------- safety

/// Blocking stops *future* ratings and updates. Ratings already given stay
/// counted on purpose: if blocking erased them, the block button would be a
/// score-washing tool — you would just block everyone who rated you honestly.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksAgainst", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// A report can name a rating without ever naming its author — the reporter
/// does not know who wrote it, and reporting must not reveal that.
model Report {
  id         String @id @default(cuid())
  reporterId String
  reporter   User   @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)

  /// The rating being disputed, when the report is about one.
  ratingId String?

  /// The thread being disputed, when the report is about a conversation.
  ///
  /// Reported separately from the person: in a rating thread the other side
  /// may be anonymous to the reporter, and a report must never be the thing
  /// that names them.
  conversationId String?

  /// The person being reported, when the report is about an account.
  reportedUserId String?
  reportedUser   User?   @relation("ReportsAbout", fields: [reportedUserId], references: [id], onDelete: SetNull)

  /// UNFAIR | ABUSIVE | FAKE | SPAM | OTHER
  reason String
  note   String?

  /// OPEN | REVIEWING | ACTIONED | DISMISSED
  status String @default("OPEN")

  /// Who closed it and when — a queue without a trail is not a queue.
  reviewerId String?
  reviewer   User?     @relation("ReportsReviewed", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([ratingId])
  @@index([conversationId])
}

// -------------------------------------------------------------- friends

/// A friendship, stored once from the requester's side.
///
/// Friends are what make direct messages possible at all, and they let the
/// People tab put the folks you actually know at the top instead of burying
/// them in the community list.
model Friendship {
  id          String @id @default(cuid())
  requesterId String
  requester   User   @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User   @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  /// PENDING | ACCEPTED
  status String @default("PENDING")

  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// ------------------------------------------------------------- messages

/// A one-to-one thread.
///
/// Two ways one can exist:
///   FRIEND — the two people are friends, both may write freely.
///   RATING — a premium member opened a thread about a rating they received.
///            The rater's identity stays hidden from the initiator unless the
///            rating was already identity-visible, and the rater may only
///            answer after the first message arrives, so a rating can never
///            become an open channel into the person who wrote it.
model Conversation {
  id String @id @default(cuid())

  /// FRIEND | RATING
  kind String @default("FRIEND")

  /// Stored with the lower id first so a pair can only ever have one thread.
  userAId String
  userA   User   @relation("ConvA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId String
  userB   User   @relation("ConvB", fields: [userBId], references: [id], onDelete: Cascade)

  /// For RATING threads: the rating it grew out of.
  ratingId String?

  /// Which side wrote the rating, and which side is shown as Anonymous.
  ///
  /// These are two different questions and were once one field, which was a
  /// bug: a Gold member can already see who rated them, so that thread has a
  /// rater but nobody hidden. Permission ("the rater may only reply once
  /// written to") keys off `raterSide`; the UI keys off `anonymousSide`.
  raterSide     String? // "A" | "B"
  anonymousSide String? // "A" | "B" — that participant is shown as Anonymous

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  /// Per-side shelf and bin. A thread is two people's, so neither may act for
  /// the other: archiving hides it from your list only, and "deleting" hides
  /// it from yours while the other side keeps the conversation they were part
  /// of. A new message clears your own deletion — somebody writing to you is
  /// exactly the event that should bring a thread back.
  archivedAAt DateTime?
  archivedBAt DateTime?
  deletedAAt  DateTime?
  deletedBAt  DateTime?

  messages Message[]

  @@unique([userAId, userBId])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([conversationId, createdAt])
}

/// A one-time code sent by email.
///
/// The code itself is never stored — only a hash, the same way a password is.
/// A leaked backup should not be a working set of account-takeover tokens.
model OtpCode {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// REGISTER | VERIFY | RESET — a code minted to confirm a new account must
  /// not be usable to reset that account's password.
  purpose  String
  /// Where it was sent. Kept so a code stays bound to the address that got it,
  /// even if the account's email changes in between.
  email    String
  codeHash String

  /// Wrong guesses so far. Enough of them burns the code.
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// A fixed-window counter for rate limiting.
///
/// In the database rather than in memory: the app is one container today but
/// a restart must not hand an attacker a fresh budget, and a second container
/// must not double it.
model RateLimit {
  id     String   @id @default(cuid())
  /// "login:1.2.3.4", "otp:someone@example.com" — the thing being limited.
  bucket String
  /// Start of the window this row counts.
  window DateTime
  count  Int      @default(1)

  @@unique([bucket, window])
  @@index([window])
}

/// Something that went wrong, kept where an admin can actually see it.
///
/// Deliberately not a third-party service: this application stores personal
/// data under KVKK, and sending stack traces to another company is a decision
/// for its owner to make, not a default to slip in.
model ErrorLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// ERROR | WARN
  level   String  @default("ERROR")
  /// Route, action or job the failure came from.
  where   String
  message String
  stack   String?
  /// Who was signed in, when there was anybody.
  userId  String?

  @@index([createdAt])
}

// ------------------------------------------------------------- discounts

/// A code an admin hands out.
///
/// Today a code grants a plan directly, because there is no billing for it to
/// discount yet — which makes it useful now for beta testers and partners
/// rather than a feature waiting on another feature. `percentOff` is carried
/// but unused; when checkout exists it is what the code will mean there.
model DiscountCode {
  id   String  @id @default(cuid())
  /// Stored upper-cased so VIBE10 and vibe10 cannot both exist.
  code String  @unique
  /// What it is for, in the admin's own words.
  note String?

  /// FREE | SILVER | GOLD — what redeeming it grants.
  plan       String @default("GOLD")
  /// How long the grant lasts. Null means it does not expire.
  days       Int?
  /// For a future checkout. Not applied anywhere today.
  percentOff Int?

  /// Null means unlimited.
  maxUses   Int?
  expiresAt DateTime?
  /// Switched off by an admin. Codes are never deleted — a redemption has to
  /// keep pointing at something, and "who gave this person Gold" is a
  /// question that gets asked long after the campaign ended.
  active    Boolean   @default(true)

  createdAt   DateTime @default(now())
  createdById String?

  redemptions DiscountRedemption[]

  @@index([createdAt])
}

/// One person using one code, once.
model DiscountRedemption {
  id     String       @id @default(cuid())
  codeId String
  code   DiscountCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// What it actually granted, recorded at the time. The code can be edited
  /// later; what somebody was given cannot.
  grantedPlan  String
  grantedUntil DateTime?
  redeemedAt   DateTime  @default(now())

  @@unique([codeId, userId])
  @@index([codeId])
  @@index([userId])
}

// --------------------------------------------------------------- store

/// One subscription bought through the App Store or Google Play.
///
/// The stores are the source of truth — this row is our mirror of what they
/// last told us, so the admin screen and support questions ("why did my Gold
/// disappear?") can be answered without calling Apple. Webhooks are treated
/// as pokes, never as facts: on every event the store's server API is asked
/// for the current state, and that answer is what lands here.
model StorePurchase {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// APPLE | GOOGLE
  platform  String
  productId String
  /// The store's stable handle for the subscription: Apple's
  /// originalTransactionId, Google's purchaseToken. Unique so a token
  /// replayed against /api/store/verify cannot grant a second account.
  storeRef  String @unique

  /// FREE | SILVER | GOLD — what productId mapped to when we last synced.
  plan      String
  /// ACTIVE | EXPIRED | REVOKED
  status    String
  expiresAt DateTime?

  /// Sandbox | Production — sandbox purchases must be visible as such.
  environment String @default("Production")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// One picture somebody uploaded.
///
/// How many a plan may hold is answered in `lib/photos.ts`, not here. Which
/// one is the profile picture lives on `User.avatarUrl`, so every existing
/// read of an avatar keeps working; the rest are side circles automatically,
/// which is why there is no second flag on this row.
model ProfilePhoto {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// JPEG data URL today, object-storage URL when photos move out of the DB.
  url String
  /// Upload order. The profile picture is whichever url User.avatarUrl holds;
  /// every other photo is a side circle, oldest first.
  position Int @default(0)

  createdAt DateTime @default(now())

  @@index([userId, position])
}
